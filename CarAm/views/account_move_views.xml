<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_caram" model="ir.ui.view">
        <field name="name">account.move.form.inherit.caram</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook name="caram_move_notebook" invisible="not is_from_api">
                    <page string="CarAm" name="caram_move">
                        <field name="note_from_api" colspan="2" nolabel="1" placeholder="No API note"/>
                        <field name="api_payload" colspan="2" widget="text" nolabel="1" placeholder="No API payload"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
